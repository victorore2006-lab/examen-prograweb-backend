<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Google.Cloud.Firestore" Version="4.4.0" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
        <PackageReference Include="Scalar.AspNetCore" Version="2.16.18" />
    </ItemGroup>

    <ItemGroup>
        <!-- El archivo real de credenciales NUNCA debe copiarse al repositorio -->
        <None Remove="Config/firebase-credentials.json" />
    </ItemGroup>

</Project>
